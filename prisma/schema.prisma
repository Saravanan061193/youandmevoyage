datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Safari {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  priceUSD        Float
  days            Int
  nights          Int
  category        String   // Tamil Nadu Journeys, Kerala Journeys, South India Journeys, Cultural Journeys, etc.
  region          String   // Tamil Nadu, Kerala, South India
  badge           String?  // Bestseller, Cultural, Custom
  image           String
  route           String   // Chennai -> Mahabalipuram -> Pondicherry -> Madurai
  startingLocation String?  // e.g. Chennai
  endingLocation  String?  // e.g. Kochi / Trivandrum
  bestTimeToTravel String? // e.g. October to March
  accommodation   String   // Boutique Heritage Hotels & Resorts
  description     String
  inclusions      String   @default("[]") // JSON string of inclusions
  exclusions      String   @default("[]") // JSON string of exclusions
  gallery         String?  @default("[]") // JSON string of images
  itineraries     String?  @default("[]") // JSON string of day-by-day itineraries
  metaTitle       String?  // SEO Meta Title
  metaDescription String? // SEO Meta Description
  keywords        String?  // SEO Meta Keywords
  featured        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Destination {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String?  @unique
  subtitle    String
  image       String
  region      String   @default("Tamil Nadu") // Tamil Nadu, Kerala, South India
  size        String   @default("short") // large, tall, short
  description String?
  highlights  String?  @default("[]") // JSON array of highlights
  experiences String?  @default("[]") // JSON array of things to experience
  duration    String?  @default("2-3 Days") // Suggested duration
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ItineraryItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  safariId      String?
  dayNumber     String   // 01, 02, 03...
  daysLabel     String   // Day 01, Days 02–03
  title         String
  description   String
  duration      String   // 3 hrs · 150 km
  mealPlan      String   // Breakfast & Local Culinary Experience
  accommodation String?
  location      String?
  image         String?
  order         Int      @default(0)
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  author      String
  country     String
  countryFlag String   // IN, US, GB, DE, FR
  rating      Int      @default(5)
  text        String
  travelType  String?  @default("Custom Family Journey")
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String
  phone               String
  category            String?
  destination         String?
  month               String?
  duration            String?
  travelers           Int      @default(2)
  message             String?
  status              String   @default("Pending") // Pending, New, Contacted, Proposal Sent, Confirmed, Completed, Cancelled
  proposalAmount      Float?   @default(0) // Quoted Amount
  followupDate        String?  @default("")
  crmNotes            String?  @default("")
  lostReason          String?  @default("")
  // Build Your Trip Multi-step Fields
  travelDates         String?
  travelStyle         String?
  destinationsList    String?  // JSON string
  interests           String?  // JSON string
  accommodationReq    String?
  vehicleReq          String?
  specialRequirements String?
  createdAt           DateTime @default(now())
}

model Experience {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  subtitle    String?
  image       String
  category    String   // Cultural, Heritage, Food, Nature, etc.
  description String
  highlights  String   @default("[]") // JSON string of highlights
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  image     String
  category  String   // Tamil Nadu, Kerala, Culture, Food, Temples, Nature, Travellers, Journeys
  location  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  // Basic Settings
  siteTitle               String?  @default("You & Me – Independent Voyage")
  siteLogo                String?  @default("") // Brand logo image URL
  contactEmail            String?  @default("youandmevoyage@gmail.com")
  whatsappNumber          String   @default("+91 9994315778")
  address                 String?  @default("Chennai, Tamil Nadu, India")
  weatherText             String   @default("South India: 28°C Pleasant")
  adminPasscode           String   @default("admin123")

  // Social Media Settings
  instagramUrl            String?  @default("https://www.instagram.com/youandmevoyage/")
  facebookUrl             String?  @default("https://www.facebook.com/p/Youme-independent-voyage-100064363920653/")
  tripadvisorUrl          String?  @default("https://www.tripadvisor.in/Attraction_Review-g304556-d21279654-Reviews-You_Me_Independent_Voyage-Chennai_Madras_Chennai_District_Tamil_Nadu.html")
  youtubeUrl              String?  @default("https://youtube.com")
  tiktokUrl               String?  @default("https://tiktok.com")
  xUrl                    String?  @default("https://x.com")
  linkedinUrl             String?  @default("https://linkedin.com")

  // Cloudinary Settings
  cloudinaryCloudName     String?  @default("youandmevoyage")
  cloudinaryApiKey        String?  @default("")
  cloudinaryApiSecret     String?  @default("")
  cloudinaryUploadPreset  String?  @default("voyage_uploads")
  enableCloudinary        Boolean  @default(false)

  // Currency Settings
  usdToEur                Float    @default(0.92)
  usdToGbp                Float    @default(0.78)
  usdToNad                Float    @default(83.5) // INR / USD rate
  defaultCurrency         String?  @default("USD")

  // Site SEO Settings
  siteMetaTitle           String?  @default("You & Me – Independent Voyage | Custom South India Private Tours")
  siteMetaDescription     String?  @default("Private journeys, authentic local experiences, and custom driver-assisted itineraries across Tamil Nadu and Kerala.")
  siteKeywords            String?  @default("South India private tours, Tamil Nadu driver, Kerala custom itinerary, private travel South India")
  googleAnalyticsId       String?  @default("G-YM12345678")
  enableRobotsIndex       Boolean  @default(true)

  // Hero & Banner Settings
  heroHeadline            String   @default("Travel South India Your Way")
  heroSubheadline         String   @default("Private journeys · Authentic experiences · Experienced local companions")
  heroCopy                String   @default("Thoughtfully crafted itineraries across Tamil Nadu, Kerala, and South India tailored specifically to your speed and preferences.")
  heroImage               String   @default("https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=1920&q=85")
  heroBanners             String?  @default("[]") // JSON array of up to 5 Hero Banners
  announcementBannerText  String?  @default("✨ Custom Private Tours for 2026 Season Now Open! Plan your Tamil Nadu & Kerala road trip today.")
  announcementBannerLink  String?  @default("/build-your-trip")
  enableAnnouncementBanner Boolean @default(true)

  // Legal CMS
  termsContent            String?  @default("Welcome to You & Me – Independent Voyage. By booking a journey with us, you agree to our booking terms, deposit conditions, cancellation policies, and liability waivers. All private journeys include dedicated vehicle, experienced local companion/driver, and customizable routes.")
  privacyContent          String?  @default("You & Me – Independent Voyage values your privacy. We strictly protect your personal information, contact details, payment info, and passport data required for bookings. We do not sell or share your data with third parties.")

  // About Page CMS Settings
  aboutHeroHeadline            String?  @default("Crafting Authentic South India Journeys")
  aboutHeroSubheadline         String?  @default("Bespoke Private Escapes · Heritage Temples · Expert Local Companions")
  aboutHeroImage               String?  @default("https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=1920&q=85")
  aboutCompanyStoryTitle       String?  @default("Our Story: Independent Travel Companions")
  aboutCompanyStorySubheadline  String?  @default("Engineered for travelers seeking authentic South Indian heritage")
  aboutCompanyStoryContent     String?  @default("Founded in Chennai, You & Me – Independent Voyage was born out of a passion for authentic cultural journeys, pristine temple architecture, and serene backwater escapes. We provide unhurried, private, and deeply personal travel experiences with dedicated local driver companions tailored to your schedule.")
  aboutCompanyStoryImage       String?  @default("https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=1200&q=85")
  aboutMission                 String?  @default("To celebrate and share South India’s rich culture and serene landscapes through sustainable, personalized private driver journeys.")
  aboutVision                  String?  @default("To set the gold standard for authentic, driver-assisted private travel in South India.")
  aboutWhyChooseUs             String?  @default("[]")
  aboutTeamMembers            String?  @default("[]")
  aboutSustainabilityTitle     String?  @default("Eco-Conscious & Authentic Local Travel")
  aboutSustainabilityContent   String?  @default("We honor the land and local communities by recommending eco-conscious heritage lodges, supporting local artisans, and promoting plastic-free travel practices across South India.")
  aboutSustainabilityImage     String?  @default("https://images.unsplash.com/photo-1593693397690-362cb9666fc2?auto=format&fit=crop&w=1200&q=85")
  aboutSafetyTitle             String?  @default("Traveler Safety & 24/7 Local Support")
  aboutSafetyContent           String?  @default("Your safety is our top priority. All private vehicles undergo thorough maintenance checks and are driven by verified, licensed local companions with 24/7 dispatch support.")
  aboutCertifications          String?  @default("[]")
  aboutAwards                  String?  @default("[]")
  aboutMetaTitle               String?  @default("")
  aboutMetaDescription         String?  @default("")
  aboutKeywords                String?  @default("")
  aboutCtaHeadline             String?  @default("Ready to Plan Your Custom South India Journey?")
  aboutCtaSubheadline          String?  @default("Speak with our travel specialists to receive a custom itinerary proposal.")
  aboutCtaButtonText           String?  @default("Request Custom Itinerary Quote")

  // Google Maps Location Settings
  googleMapEmbedUrl            String?  @default("https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.498305719363!2d80.25268487507693!3d13.003923387313888!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a5267e7c992769d%3A0xbbfd1d36d4f9c158!2sIndira%20Nagar%2C%20Adyar%2C%20Chennai%2C%20Tamil%20Nadu%20600020!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin")
  officeAddress                String?  @default("Indira Nagar, Adyar, Chennai, Tamil Nadu, India - 600020")
  officePhone                  String?  @default("+91 9994315778")
  operationHours               String?  @default("Mon – Sat: 08:00 – 18:00 · 24/7 Dispatch")
  showGoogleMapInFooter        Boolean  @default(true)

  // Home Page Signature Itinerary CMS
  homeItineraryHeadline        String?  @default("10-day classic South India explorer")
  homeItineraryCopy            String?  @default("One signature journey. Tamil Nadu temples, Chettinad heritage, Munnar tea hills, and Kerala backwaters in seamless sequence.")
