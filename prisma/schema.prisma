datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Safari {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  priceUSD      Float
  days          Int
  nights        Int
  category      String   // Private, Luxury Tented, Adventure
  region        String   // South, Central, North
  badge         String?  // Bestseller, Luxury, Wildlife
  image         String
  route         String   // Windhoek -> Sossusvlei -> Swakopmund -> Etosha
  accommodation String   // Luxury Lodges & Tented Camps
  description   String
  inclusions    String   @default("[]") // JSON string of inclusions
  exclusions    String   @default("[]") // JSON string of exclusions
  metaTitle     String?  // SEO Meta Title
  metaDescription String? // SEO Meta Description
  keywords      String?  // SEO Meta Keywords
  featured      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Destination {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String
  image       String
  region      String   @default("Central")
  size        String   @default("short") // large, tall, short
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ItineraryItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  safariId      String?
  dayNumber     String   // 01, 02, 03...
  daysLabel     String   // Day 01, Days 02–03
  title         String
  description   String
  duration      String   // 45 min · 35 km
  mealPlan      String   // Dinner, Full Board
  accommodation String?
  location      String?
  image         String?
  order         Int      @default(0)
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  author      String
  country     String
  countryFlag String   // DE, US, GB, FR
  rating      Int      @default(5)
  text        String
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String
  category    String?
  destination String?
  month       String?
  duration    String?
  travelers   Int      @default(2)
  message     String?
  status      String   @default("Pending") // Pending, Contacted, Follow Up, Proposal Sent, Converted, Lost
  proposalAmount Float? @default(0) // Quoted / Proposal Amount in USD
  followupDate String? @default("")
  crmNotes    String?  @default("")
  lostReason  String?  @default("")
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  // Basic Settings
  siteTitle               String?  @default("Discovery Safaris Namibia")
  siteLogo                String?  @default("") // Brand logo image URL
  contactEmail            String?  @default("info@discoverysafaris.com")
  whatsappNumber          String   @default("+264 81 123 4567")
  weatherText             String   @default("Etosha National Park: 28°C Sunny")
  adminPasscode           String   @default("admin123")

  // Social Media Settings
  instagramUrl            String?  @default("https://instagram.com")
  facebookUrl             String?  @default("https://facebook.com")
  youtubeUrl              String?  @default("https://youtube.com")
  tiktokUrl               String?  @default("https://tiktok.com")
  xUrl                    String?  @default("https://x.com")
  linkedinUrl             String?  @default("https://linkedin.com")

  // Cloudinary Settings
  cloudinaryCloudName     String?  @default("discovery-safaris")
  cloudinaryApiKey        String?  @default("")
  cloudinaryApiSecret     String?  @default("")
  cloudinaryUploadPreset  String?  @default("safari_uploads")
  enableCloudinary        Boolean  @default(false)

  // Currency Settings
  usdToEur                Float    @default(0.92)
  usdToGbp                Float    @default(0.78)
  usdToNad                Float    @default(18.5)
  defaultCurrency         String?  @default("USD")

  // Site SEO Settings
  siteMetaTitle           String?  @default("Discovery Safaris Namibia | Luxury Private Tours & Expeditions")
  siteMetaDescription     String?  @default("Experience the raw majesty of Namibia with bespoke private safaris, luxury tented camps, and wildlife expeditions.")
  siteKeywords            String?  @default("namibia safari, luxury travel, etosha wildlife, sossusvlei dunes")
  googleAnalyticsId       String?  @default("G-DS12345678")
  enableRobotsIndex       Boolean  @default(true)

  // Hero & Banner Settings
  heroHeadline            String   @default("Experience the raw majesty of Namibia")
  heroSubheadline         String   @default("Private journeys · Wild places · 2004—2026")
  heroCopy                String   @default("Bespoke private safaris, luxury tented camps, and wildlife expeditions engineered for international travelers.")
  heroImage               String   @default("https://images.unsplash.com/photo-1549366021-9f761d450615?auto=format&fit=crop&w=1920&q=85")
  heroBanners             String?  @default("[]") // JSON array of up to 5 Hero Banners
  announcementBannerText  String?  @default("🔥 Special Offer: Save 15% on 2026 Private Fly-in Safaris! Book by end of month.")
  announcementBannerLink  String?  @default("/safari/classic-namibia-expedition")
  enableAnnouncementBanner Boolean @default(true)

  // Legal CMS
  termsContent            String?  @default("Welcome to Discovery Safaris Namibia. By booking a tour with us, you agree to our booking terms, deposit conditions, cancellation policies, and liability waivers. All private safaris include comprehensive guide coverage, vehicle insurance, and park entry permits.")
  privacyContent          String?  @default("Discovery Safaris Namibia values your privacy. We strictly protect your personal information, contact details, payment info, and passport data required for park registrations. We do not sell or share your data with third parties.")
  updatedAt               DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  coverImage      String
  author          String   @default("Discovery Safaris Team")
  authorRole      String   @default("Safari Specialist")
  category        String   @default("Travel Guide")
  readTime        String   @default("5 min read")
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

