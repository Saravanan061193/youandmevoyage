model BlogPost {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  coverImage      String
  author          String   @default("You & Me Travel Team")
  authorRole      String   @default("South India Travel Specialist")
  category        String   @default("Travel Guide")
  readTime        String   @default("5 min read")
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  category  String   @default("Booking & Inclusions")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


